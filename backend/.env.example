# Application
PROJECT_NAME="Cineverse API"
API_V1_STR="/api"
PORT=8000
DEBUG=True

# Database (Default: SQLite for zero-config dev, replace with postgresql://user:password@localhost:5432/cineverse)
DATABASE_URL="sqlite:///./cineverse.db"

# TMDB API (Optional: if blank, Cineverse uses bundled curated offline dataset)
TMDB_API_KEY=""
TMDB_BASE_URL="https://api.themoviedb.org/3"
TMDB_IMAGE_BASE_URL="https://image.tmdb.org/t/p"

# CORS Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
